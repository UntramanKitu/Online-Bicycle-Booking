# ==== ตัวอย่างค่าคอนฟิกฐานข้อมูล (ไม่ควร commit .env จริง) ====
# คัดลอกเป็น .env แล้วแก้ตามที่ต้องการ

# PostgreSQL ท้องถิ่น (Docker ตาม docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=bikea
DB_USER=bikea
DB_PASSWORD=bikea

# sslmode: prefer (ค่าเริ่มต้น) / disable / require
# - ท้องถิ่น: prefer หรือ disable ก็ได้
# - คลาวด์ที่บังคับ SSL เช่น Supabase: require
DB_SSLMODE=prefer

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-this-in-local-env

# Google OAuth (create credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-this-in-local-env