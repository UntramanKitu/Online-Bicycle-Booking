# ==== ตัวอย่างค่าคอนฟิกฐานข้อมูล (ไม่ควร commit .env จริง) ====
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ตามที่ต้องการ
# ค่า host/port ของ OAuth ต้องตรงกับ frontend/.env (VITE_API_URL) เพราะ cookie ผูกกับ host

# PostgreSQL ท้องถิ่น (รันด้วย `docker compose up -d db` — compose นี้มีแค่ service db)
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=bikea
DB_USER=bikea
DB_PASSWORD=bikea

# sslmode: prefer (ค่าเริ่มต้น) / disable / require
# - ท้องถิ่น: prefer หรือ disable ก็ได้
# - คลาวด์ที่บังคับ SSL เช่น Supabase: require
DB_SSLMODE=prefer

# Google OAuth (สร้าง credentials ที่ Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8002/api/auth/google/callback
FRONTEND_URL=http://127.0.0.1:5173
JWT_SECRET=change-this-in-local-env