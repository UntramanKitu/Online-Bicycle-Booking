# ==== ตัวอย่างค่าคอนฟิกฐานข้อมูล (ไม่ควร commit .env จริง) ====
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ตามที่ต้องการ
# ค่า host/port ของ OAuth ต้องตรงกับ frontend/.env (VITE_API_URL) เพราะ cookie ผูกกับ host

# PostgreSQL ท้องถิ่น (รันด้วย `docker compose up -d db` — compose นี้มีแค่ service db)
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=bikea
DB_USER=bikea
DB_PASSWORD=bikea

# sslmode: prefer (ค่าเริ่มต้น) / disable / require
# - ท้องถิ่น: prefer หรือ disable ก็ได้
# - คลาวด์ที่บังคับ SSL เช่น Supabase: require
DB_SSLMODE=prefer

# ==== Google OAuth ====
# ใช้ OAuth client ชุดเดียวกันร่วมกันได้หลายแอป แต่ redirect_uri ต้องลงทะเบียน
# ไว้ใน Google Cloud Console แยก "ทุกตัว" (Google จับคู่แบบ exact match ไม่รับ wildcard)
#   Authorized redirect URIs:
#     http://127.0.0.1:8002/api/auth/google/callback   ← backend ฝั่ง FastAPI (นี้)
#     http://127.0.0.1:<port ของ client-server>/...    ← เพิ่มเองตามที่เพื่อนใช้
#
# ค่า host ต้องตรงกับ frontend/.env (VITE_API_URL) เพราะ OAuth cookie ผูกกับ host
# localhost กับ 127.0.0.1 ถือเป็นคนละ host — เลือกอันเดียวแล้วใช้ให้เหมือนกันทั้งระบบ
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8002/api/auth/google/callback
FRONTEND_URL=http://127.0.0.1:5173
JWT_SECRET=change-this-in-local-env

# ตาราง accounts_unifieduser เป็นของ Django Monolith
# true  = ให้ FastAPI สร้าง user ใหม่เองได้ (ตอนนี้ยังไม่มี Django จึงต้องเปิดไว้)
# false = อ่านอย่างเดียว ถ้าไม่เจอ user จะขึ้นว่า "ยังไม่ได้ลงทะเบียน"
#
# !!! เปลี่ยนเป็น false ทันทีที่ Django Monolith ขึ้นใช้งานจริง !!!
#     ไม่งั้นสองฝั่งจะเขียนตารางเดียวกันพร้อมกันและข้อมูลชนกัน
AUTH_USER_PROVISIONING=true

# ย้ายข้อมูลจาก unified_user (schema เดิม) ไป accounts_unifieduser (schema แบบ Django)
# รันครั้งเดียวได้ idempotent: uv run python -m app.migrate_users

# Origin เพิ่มเติมที่อนุญาตให้เรียก API ได้ (คั่นด้วย comma) ใช้เพิ่ม port ของ client-server
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8000