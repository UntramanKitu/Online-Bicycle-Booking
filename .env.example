POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Use a database dedicated to M13-M15 development (not the team's shared
# bike_booking_db) so this module's local User/Bicycle stub tables never
# collide with the real tables from other modules.
POSTGRES_DB=bike_booking_m13m15_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
FRONTEND_ORIGIN=http://localhost:5173

# Alternative advanced option:
# DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/bike_booking_m13m15_dev