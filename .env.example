# ตัวอย่างไฟล์ตั้งค่าลับ — copy เป็นชื่อ .env แล้วกรอกค่าจริง
# (ไฟล์ .env จริงๆ ห้าม commit ขึ้น git เด็ดขาด)

# ---- Google OAuth 2.0 (ล็อกอินผ่าน Google) ----
# สมัครได้ที่ https://console.cloud.google.com/apis/credentials
# Authorized redirect URI ที่ต้องตั้งใน Google Console:
#   http://127.0.0.1:8000/social-auth/complete/google-oauth2/
GOOGLE_OAUTH2_KEY=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_SECRET=your-google-client-secret
